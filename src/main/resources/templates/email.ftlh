<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:32px;background:#f4f6fb;font-family:Arial,sans-serif;color:#26344f;">
	<table role="presentation" width="100%" cellspacing="0" cellpadding="0">
		<tr>
			<td align="center">
				<table role="presentation" width="100%" cellspacing="0" cellpadding="0"
					style="max-width:560px;background:#fff;border-radius:12px;padding:32px;">
					<tr>
						<td>
							<h1 style="margin:0 0 16px;color:#203866;font-size:24px;">Reset your Spiriponzi password</h1>
							<p style="line-height:1.6;">We received a request to reset the password for your account. Use the button below to choose a new password. This link expires in 30 minutes and can only be used once.</p>
							<p style="margin:28px 0;text-align:center;">
								<a href="${resetUrl}"
									style="display:inline-block;padding:13px 22px;border-radius:6px;background:#4e73df;color:#fff;text-decoration:none;font-weight:bold;">
									Choose a new password
								</a>
							</p>
							<p style="line-height:1.6;color:#68738a;">If you didn't request a password reset, you can ignore this email. Your password will not change.</p>
							<p style="margin:24px 0 0;color:#68738a;font-size:13px;">Spiriponzi</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>
